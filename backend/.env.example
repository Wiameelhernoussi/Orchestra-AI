DATABASE_URL=sqlite:///./orchestra.db
GROQ_API_KEY=your_groq_api_key_here
GROQ_INTENT_MODEL=openai/gpt-oss-120b
GROQ_EVIDENCE_MODEL=qwen/qwen3.8-27b
GROQ_EVIDENCE_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_COMPARE_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_INTENT_MAX_COMPLETION_TOKENS=1200
GROQ_EVIDENCE_MAX_COMPLETION_TOKENS=800
GROQ_MAX_RETRIES=2
GROQ_MAX_RETRY_WAIT_SECONDS=60
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
